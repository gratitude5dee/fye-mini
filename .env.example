# Local-only runtime values. Keep real credentials in .env.local and in Sites secrets.
ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
ATLAS_DB=living_grimoire
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
VITE_VOICE_ENABLED=true
# Long random server-only secret used to sign anonymous device identities.
BENDER_TOKEN_SECRET=
