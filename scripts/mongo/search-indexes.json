{
  "text": {
    "name": "spell_text",
    "definition": {
      "mappings": {
        "dynamic": false,
        "fields": {
          "name": [
            { "type": "string", "analyzer": "lucene.english" },
            { "type": "autocomplete", "analyzer": "lucene.english", "tokenization": "edgeGram", "minGrams": 2, "maxGrams": 15, "foldDiacritics": true }
          ],
          "incantation": { "type": "string", "analyzer": "lucene.english" },
          "lore": { "type": "string", "analyzer": "lucene.english" },
          "tags": { "type": "string", "analyzer": "lucene.english" },
          "element": { "type": "token" },
          "lineage": {
            "type": "document",
            "fields": { "rootId": { "type": "objectId" } }
          }
        }
      }
    }
  },
  "vector": {
    "name": "spell_vector",
    "type": "vectorSearch",
    "definition": {
      "fields": [
        { "type": "vector", "path": "embedding", "numDimensions": 1024, "similarity": "cosine", "quantization": "scalar" },
        { "type": "filter", "path": "element" },
        { "type": "filter", "path": "lineage.rootId" },
        { "type": "filter", "path": "stats.casts" }
      ]
    }
  }
}
